#
# HotCRP multi-conference Nginx configuration
#
# This server block routes multiple conference paths
# (e.g. /testconf, /<confid>) to a single HotCRP instance.
#
# Each conference is handled via PHP-FPM and internally
# mapped to index.php with PATH_INFO routing.
#

server {
    listen 80 default_server;

    client_max_body_size 12M;

    root /var/www/html;
    index index.php index.html;

    location ~ ^${HOTCRP_SITEPATH}/testconf(/.*)?$ {
        fastcgi_pass hotcrp:9000;

        fastcgi_split_path_info ^(${HOTCRP_SITEPATH}/testconf)(/.*)$;

        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        include fastcgi_params;
    }

    location ~ ^${HOTCRP_SITEPATH}/latam-se-school(/.*)?$ {
        fastcgi_pass hotcrp:9000;

        fastcgi_split_path_info ^(${HOTCRP_SITEPATH}/latam-se-school)(/.*)$;

        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        include fastcgi_params;
    }

    # ---------------------------------------------------------------------
    # TEMPLATE: additional conferences
    # ---------------------------------------------------------------------
    #
    # Copy this block for each new conference.
    #
    # Example:
    #
    # location ~ ^${HOTCRP_SITEPATH}/<confid>(/.*)?$ {
    #     fastcgi_pass hotcrp:9000;
    #
    #     fastcgi_split_path_info ^(${HOTCRP_SITEPATH}/<confid>)(/[\s\S]*)$;
    #
    #     fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
    #     fastcgi_param PATH_INFO $fastcgi_path_info;
    #
    #     include fastcgi_params;
    # }
    #

    location ~ ^${HOTCRP_SITEPATH}(/.*)?$ {
        fastcgi_pass hotcrp:9000;

        fastcgi_split_path_info ^(${HOTCRP_SITEPATH})(/.*)$;

        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        include fastcgi_params;
    }
}